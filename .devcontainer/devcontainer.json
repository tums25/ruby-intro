{
  "name": "ruby-intro",
  "image": "ruby:4.0.5",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "ruby-intro", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["vortizhe.simple-ruby-erb", "MS-vsliveshare.vsliveshare"],
      "settings": {
        "editor.stickyScroll.enabled": true,
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "[ruby]": {
          "editor.tabSize": 2,
          "editor.insertSpaces": true
        }
      }
    }
  }
}
