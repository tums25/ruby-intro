<!DOCTYPE html>
<html>
  <head>
    <title><%= [content_for(:title), "ruby-intro"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      pre, code { font-family: ui-monospace, Menlo, Consolas, monospace !important; }
    </style>
  </head>

  <body class="bg-stone-50 text-stone-900">
    <nav class="bg-stone-900 text-stone-100 px-6 py-3 flex gap-6 text-sm">
      <%= link_to "ruby-intro", root_path, class: "font-semibold hover:underline" %>
    </nav>
    <main class="<%= content_for?(:wide) ? "max-w-screen-2xl" : "max-w-5xl" %> mx-auto p-6">
      <%= yield %>
    </main>
  </body>
</html>
